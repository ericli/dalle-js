{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build -- --base /dalle/",
  "outputDirectory": "dist",
  "redirects": [{ "source": "/", "destination": "/dalle", "permanent": false }],
  "rewrites": [
    { "source": "/dalle/", "destination": "/index.html" },
    { "source": "/dalle/:path*", "destination": "/:path*" }
  ]
}
